# Server
NODE_ENV=development
PORT=3000

# Database
MONGODB_URI=mongodb://localhost:27017/subtrack

# JWT
JWT_ACCESS_SECRET=your-jwt-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-jwt-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OAuth - Google
GOOGLE_CLIENT_ID=your-google-client-id

# OAuth - Apple
APPLE_CLIENT_ID=your-apple-client-id

# Email (for OTP)
EMAIL_PROVIDER_API_KEY=your-email-provider-api-key
EMAIL_FROM=noreply@subtrack.com

# Expo Push Notifications
EXPO_ACCESS_TOKEN=your-expo-access-token

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:19006,exp://192.168.1.1:19000

# Logging
LOG_LEVEL=info
