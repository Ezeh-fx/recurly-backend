# Server
NODE_ENV=development
PORT=3000

# Database
MONGODB_URI=mongodb://localhost:27017/subtrack

# JWT
JWT_SECRET=your-jwt-secret-here-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# OAuth - Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_ID_IOS=your-google-ios-client-id
GOOGLE_CLIENT_ID_ANDROID=your-google-android-client-id

# OAuth - Apple
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY=your-apple-private-key
APPLE_BUNDLE_ID=your-apple-bundle-id

# Email (for OTP)
EMAIL_SERVICE=your-email-service
EMAIL_USER=your-email-user
EMAIL_PASSWORD=your-email-password
EMAIL_FROM=noreply@subtrack.com

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:19006,exp://192.168.1.1:19000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# Logging
LOG_LEVEL=info
