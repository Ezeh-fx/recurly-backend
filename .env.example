# Server
NODE_ENV=development
PORT=3000

# Database
MONGODB_URI=mongodb://localhost:27017/subtrack

# JWT
JWT_ACCESS_SECRET=your-jwt-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=your-jwt-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OAuth - Google
GOOGLE_CLIENT_ID=your-google-client-id

# OAuth - Apple
APPLE_CLIENT_ID=your-apple-client-id

# Email (for OTP) - Resend (primary)
RESEND_API_KEY=re_xxxxxxxxx

# Email (for OTP) - Gmail (fallback) - Option 1: App Password
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# Email (for OTP) - Gmail (fallback) - Option 2: OAuth2 (recommended)
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=your-google-oauth-refresh-token

EMAIL_FROM=noreply@subtrack.com

# Expo Push Notifications
EXPO_ACCESS_TOKEN=your-expo-access-token

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:19006,exp://192.168.1.1:19000

# Logging
LOG_LEVEL=info